{
  "id": "0b7a1e8d-12f1-4a4d-ae4d-5a1f6d0b8e21",
  "name": "AI Passport",
  "version": "1.0.5",
  "apiVersion": "1",
  "platforms": ["darwin"],
  "architectures": ["arm64"],
  "transports": ["ble"],
  "capabilities": {
    "ptt": true,
    "streamOnly": true,
    "sendEnter": true,
    "deleteChar": true,
    "clearInput": true
  },
  "permissions": ["bluetooth", "native-helper", "accessibility"],
  "icon": "assets/icon.svg",
  "ui": { "entrypoint": "ui/index.html" },
  "worker": { "entrypoint": "worker/index.mjs", "args": [] }
}
